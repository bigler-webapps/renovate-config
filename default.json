{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":enableVulnerabilityAlertsWithLabel(security)"
  ],
  "timezone": "Europe/Zurich",
  "schedule": ["before 6am on wednesday"],
  "prConcurrentLimit": 1,
  "prHourlyLimit": 0,
  "labels": ["dependencies"],
  "baseBranches": ["develop"],
  "rangeStrategy": "bump",
  "minimumReleaseAge": "7 days",
  "ignorePaths": ["**/package-lock.json", "**/node_modules/**", "**/build/**"],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"],
    "minimumReleaseAge": "0 days"
  },
  "packageRules": [
    {
      "description": "Majors require manual approval via Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Bundle all non-major npm updates into one weekly PR",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch", "pin"],
      "groupName": "npm non-major"
    },
    {
      "description": "Bundle all non-major Python updates into one weekly PR",
      "matchManagers": ["pip_requirements", "pip-compile", "poetry", "pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "python non-major"
    },
    {
      "description": "Bundle all non-major Docker tag updates into one weekly PR",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "docker non-major"
    },
    {
      "description": "Bundle all non-major GitHub Actions updates into one weekly PR",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin"],
      "groupName": "github-actions"
    },
    {
      "description": "Bundle all non-major Gradle / Maven updates into one weekly PR",
      "matchManagers": ["gradle", "gradle-wrapper", "maven"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "java non-major"
    },
    {
      "description": "Skip MUI v9 — new pricing model (~3x cost, per-app license). Stay on current major lines, keep receiving patches and minors.",
      "matchPackagePrefixes": ["@mui/"],
      "allowedVersions": "<9"
    }
  ]
}
